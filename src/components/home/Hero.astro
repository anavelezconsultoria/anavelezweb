---
import Button from '../Button.astro';
import { profile } from '../../data/profile';
import { highlights } from '../../data/services';
---

<section class="hero">
  <div class="orbits" aria-hidden="true">
    <span class="ring ring-lg"></span>
    <span class="ring ring-md"></span>
    <span class="dot"></span>
  </div>

  <div class="container content">
    <p class="eyebrow">{profile.tagline}</p>
    <h1>
      <span>{profile.firstNames}</span>
      <span class="accent">{profile.lastNames}</span>
    </h1>
    <p class="lead intro">{profile.intro}</p>
    <div class="actions">
      <Button href="/proyectos" arrow>Ver proyectos</Button>
      <Button href="#contacto" variant="ghost">Contáctame</Button>
    </div>
  </div>

  <div class="container">
    <ul class="credentials" aria-label="Credenciales">
      {highlights.map((h) => (
        <li>
          <span class="value">{h.value}</span>
          <span class="label">{h.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(56px, 9vw, 112px);
  }

  .content {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  h1 {
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  h1 span {
    display: block;
  }

  .accent {
    color: var(--color-blue);
  }

  .intro {
    max-width: 620px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .credentials {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(56px, 8vw, 96px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-lavender);
  }

  .credentials li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-5) var(--space-6) 0;
  }

  .credentials li + li {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-lavender);
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    color: var(--color-blue);
  }

  .label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .orbits {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(215, 186, 252, 0.7);
  }

  .ring-lg {
    width: 720px;
    height: 720px;
    right: -220px;
    top: -80px;
  }

  .ring-md {
    width: 460px;
    height: 460px;
    right: -90px;
    top: 50px;
  }

  .dot {
    position: absolute;
    width: 240px;
    height: 240px;
    right: 120px;
    top: 200px;
    border-radius: 50%;
    background: var(--color-lavender);
    opacity: 0.45;
    animation: float 9s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-18px);
    }
  }

  @media (max-width: 860px) {
    .credentials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .credentials li + li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .credentials li:nth-child(n + 3) {
      border-top: 1px solid var(--color-lavender);
    }
  }

  @media (max-width: 720px) {
    .ring-lg { width: 420px; height: 420px; right: -220px; top: -40px; }
    .ring-md { width: 260px; height: 260px; right: -130px; top: 40px; }
    .dot { width: 120px; height: 120px; right: -30px; top: 110px; }
  }
</style>
