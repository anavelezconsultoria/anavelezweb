---
import ContactForm from '../ContactForm.astro';
import { profile } from '../../data/profile';
---

<section class="contact" id="contacto">
  <div class="container grid">
    <div class="intro">
      <p class="eyebrow">Contacto</p>
      <h2>Hablemos de tu proyecto.</h2>
      <p class="lead">
        ¿Lista para llevar tu empresa al siguiente nivel? Estoy disponible para proyectos de consultoría y
        desarrollo en Colombia y Latinoamérica.
      </p>
      <ul class="channels">
        {profile.contact.map((channel) => (
          <li>
            <a href={channel.href} rel={channel.kind === 'linkedin' ? 'noopener' : undefined} target={channel.kind === 'linkedin' ? '_blank' : undefined}>
              {channel.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .contact {
    background: var(--color-ink);
    color: var(--color-on-dark);
    padding-block: var(--space-section);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(48px, 8vw, 112px);
  }

  .intro {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .eyebrow {
    color: var(--color-lavender);
  }

  h2 {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.05;
  }

  .lead {
    color: var(--color-on-dark-muted);
  }

  .channels {
    display: grid;
    gap: 14px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    font-size: 14px;
  }

  .channels a {
    text-decoration: none;
    border-bottom: 1px solid rgba(215, 186, 252, 0.35);
    transition: border-color 0.2s;
  }

  .channels a:hover {
    border-color: var(--color-lavender);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
