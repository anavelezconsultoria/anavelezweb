---
import TextoAnimado from './TextoAnimado.astro';

interface Props {
  readonly eyebrow: string;
  readonly title: string;
  readonly as?: 'h1' | 'h2';
  readonly divider?: boolean;
}

const { eyebrow, title, as: Tag = 'h2', divider = false } = Astro.props;
---

<div class:list={['heading', { divider }]} data-revelar="subir">
  <p class="eyebrow"><span class="linea-eyebrow" aria-hidden="true"></span>{eyebrow}</p>
  <Tag class="title"><TextoAnimado texto={title} modo="palabras" alVer /></Tag>
  <slot />
</div>

<style>
  .heading {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .divider {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-lavender);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* La rayita del eyebrow crece cuando la seccion aparece. */
  .linea-eyebrow {
    width: 0;
    height: 2px;
    background: var(--color-blue);
    transition: width 700ms var(--ease-salida) 200ms;
  }

  :global(.visible) > .eyebrow .linea-eyebrow,
  .heading:global(.visible) .linea-eyebrow {
    width: 28px;
  }

  :global(html:not(.js)) .linea-eyebrow {
    width: 28px;
  }

  .title {
    font-size: clamp(30px, 4.6vw, 48px);
    line-height: 1.1;
  }
</style>
