---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'purple' | 'outline' | 'ghost' | 'light';
type Size = 'sm' | 'md';

interface Props extends HTMLAttributes<'a'> {
  readonly href: string;
  readonly variant?: Variant;
  readonly size?: Size;
  readonly arrow?: boolean;
}

const { href, variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, `btn-${size}`, className]} {...rest}>
  <slot />
  {arrow && <span aria-hidden="true" class="arrow">&rarr;</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s var(--ease-salida);
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(1px) scale(0.98);
  }

  .btn-md { padding: 14px 26px; }
  .btn-sm { padding: 11px 24px; }

  .btn-primary { background: var(--color-blue); color: #fff; box-shadow: 0 6px 18px rgba(43, 76, 242, 0.3); }
  .btn-primary:hover { background: var(--color-blue-strong); }

  .btn-purple { background: var(--color-purple); color: #fff; box-shadow: 0 6px 18px rgba(106, 79, 224, 0.3); }
  .btn-purple:hover { background: var(--color-purple-strong); }

  .btn-outline { border-color: var(--color-blue); color: var(--color-blue); background: var(--color-surface); }
  .btn-outline:hover { background: var(--color-blue-soft); }

  .btn-ghost { border-color: #d9d2ef; color: var(--color-ink); background: var(--color-surface); }
  .btn-ghost:hover { border-color: var(--color-purple); color: var(--color-purple); }

  .btn-light { background: #fff; color: var(--color-ink); }
  .btn-light:hover { background: var(--color-lavender-soft); }

  .arrow { transition: transform 0.2s; }
  .btn:hover .arrow { transform: translateX(3px); }
</style>
