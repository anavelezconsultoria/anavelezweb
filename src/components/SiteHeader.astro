---
import { Image } from 'astro:assets';
import logo from '../assets/logo-recortado.png';
import Button from './Button.astro';
import { navLinks, profile } from '../data/profile';

const currentPath = Astro.url.pathname.replace(/(\.html)?\/?$/, '') || '/';
---

<header class="header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${profile.fullName}, inicio`}>
      <Image src={logo} alt="" height={64} width={79} loading="eager" class="logo" />
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul class="links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <Button href="/#contacto" variant="purple" size="sm" class="cta-desktop">Hablemos</Button>

    <details class="nav-mobile">
      <summary aria-label="Abrir menú">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
        Menú
      </summary>
      <nav aria-label="Principal móvil" class="sheet">
        <ul>
          {navLinks.map((link) => (
            <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
        <Button href="/#contacto" arrow>Hablemos</Button>
      </nav>
    </details>
  </div>
</header>

<script>
  // Cierra el menu movil al navegar a un ancla de la misma pagina.
  document.querySelectorAll<HTMLDetailsElement>('.nav-mobile').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) menu.open = false;
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--color-line);
    transition: box-shadow 300ms, background-color 300ms;
  }

  .header:global(.con-scroll) {
    box-shadow: 0 8px 30px rgba(106, 79, 224, 0.08);
    background: rgba(255, 255, 255, 0.92);
  }

  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand {
    margin-right: auto;
    display: inline-flex;
    transition: transform 300ms var(--ease-salida);
  }

  .brand:hover {
    transform: scale(1.04);
  }

  .logo {
    height: 64px;
    width: auto;
  }

  .links {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    display: inline-block;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }

  .links a:hover {
    color: var(--color-ink);
    background: var(--color-lavender-soft);
  }

  .links a[aria-current='page'] {
    color: var(--color-purple);
    background: var(--color-lavender-soft);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 720px) {
    .nav-desktop,
    .bar > :global(.cta-desktop) {
      display: none;
    }

    .nav-mobile {
      display: block;
    }

    summary {
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 10px 18px;
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-purple);
      background: var(--color-lavender-soft);
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-lavender);
      cursor: pointer;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .burger {
      display: grid;
      gap: 4px;
      width: 14px;
    }

    .burger span {
      height: 1.5px;
      background: currentColor;
      transition: transform 0.2s;
    }

    .nav-mobile[open] .burger span:first-child {
      transform: translateY(2.75px) rotate(45deg);
    }

    .nav-mobile[open] .burger span:last-child {
      transform: translateY(-2.75px) rotate(-45deg);
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--header-height);
      display: grid;
      gap: var(--space-5);
      padding: var(--space-5) var(--gutter) var(--space-6);
      background: var(--color-cream);
      border-bottom: 1px solid var(--color-lavender);
      box-shadow: 0 24px 40px -24px rgba(106, 79, 224, 0.25);
    }

    .sheet ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .sheet li a {
      display: block;
      padding: var(--space-4) 0;
      font-family: var(--font-display);
      font-size: 1.25rem;
      text-decoration: none;
      border-bottom: 1px solid var(--color-line);
    }

    .sheet li a[aria-current='page'] {
      color: var(--color-blue);
    }
  }
</style>
