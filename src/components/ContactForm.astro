---
import { WEB3FORMS_ENDPOINT } from '../lib/contact-form';
import { contactEmail, profile } from '../data/profile';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const thankYouUrl = new URL('/gracias', Astro.site ?? profile.siteUrl).href;
---

{accessKey ? (
  <form class="form" action={WEB3FORMS_ENDPOINT} method="POST" data-contact-form>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Nuevo mensaje desde anavelezconsultora.com" />
    <input type="hidden" name="from_name" value="Sitio web Ana Vélez" />
    <input type="hidden" name="redirect" value={thankYouUrl} />
    <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="row">
      <label>
        <span>Nombre</span>
        <input type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Tu nombre" />
      </label>
      <label>
        <span>Correo electrónico</span>
        <input type="email" name="email" required maxlength="160" autocomplete="email" placeholder="tu@correo.com" />
      </label>
    </div>
    <label>
      <span>Asunto</span>
      <input type="text" name="asunto" required maxlength="160" placeholder="¿En qué te puedo ayudar?" />
    </label>
    <label>
      <span>Mensaje</span>
      <textarea name="message" required minlength="10" maxlength="4000" rows="5" placeholder="Cuéntame sobre tu proyecto..."></textarea>
    </label>

    <div class="actions">
      <button type="submit">Enviar mensaje <span aria-hidden="true">&rarr;</span></button>
      <p class="status" data-form-status role="status" aria-live="polite"></p>
    </div>
  </form>
) : (
  <div class="fallback">
    <p class="fallback-label">Escríbeme directamente</p>
    <a class="fallback-email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
    <p>Cuéntame el reto, el contexto de tu equipo y los plazos. Con eso preparo una primera conversación útil.</p>
    <a class="fallback-cta" href={`mailto:${contactEmail}?subject=Proyecto%20de%20consultor%C3%ADa`}>Enviar correo <span aria-hidden="true">&rarr;</span></a>
  </div>
)}

<script>
  import { enhanceContactForm } from '../lib/contact-form';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(enhanceContactForm);
</script>

<style>
  .form {
    display: grid;
    gap: 28px;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  label {
    display: grid;
    gap: 10px;
  }

  label span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  input,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 15px;
    color: var(--color-on-dark);
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(245, 243, 255, 0.25);
    padding: 8px 0;
    resize: vertical;
    transition: border-color 0.2s;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(185, 182, 214, 0.6);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--color-lavender);
  }

  .honeypot {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  button {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    gap: 10px;
    padding: 14px 24px;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-blue);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s, opacity 0.2s;
  }

  button:hover {
    background: var(--color-blue-strong);
  }

  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    font-size: 14px;
    color: var(--color-on-dark-muted);
  }

  .status[data-state='success'] {
    color: var(--color-lavender-deco);
  }

  .status[data-state='error'] {
    color: #ffb4b4;
  }

  .fallback {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    align-self: start;
    justify-items: start;
    padding: var(--space-6);
    border: 1px solid rgba(215, 186, 252, 0.3);
    color: var(--color-on-dark-muted);
  }

  .fallback-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lavender-deco);
  }

  .fallback-email {
    font-weight: 600;
    font-size: clamp(16px, 0.9rem + 0.5vw, 22px);
    color: var(--color-on-dark);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-lavender);
  }

  .fallback-cta {
    display: inline-flex;
    gap: 10px;
    margin-top: var(--space-2);
    padding: 14px 24px;
    background: var(--color-blue);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .fallback-cta:hover {
    background: var(--color-blue-strong);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
