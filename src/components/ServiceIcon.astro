---
import type { ServiceIcon } from '../types/content';

interface Props {
  readonly name: ServiceIcon;
}

const PATHS: Record<ServiceIcon, string> = {
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5',
  strategy: 'M4 20h16M6 20V10l6-5 6 5v10M10 20v-5h4v5',
  cloud: 'M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6 11a3.5 3.5 0 0 0 1 7z',
  training: 'M3 9l9-4 9 4-9 4-9-4zM7 11v5c0 1.5 2.5 3 5 3s5-1.5 5-3v-5',
};

const { name } = Astro.props;
---

<span class="icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d={PATHS[name]}></path>
  </svg>
</span>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-lavender-soft);
    color: var(--color-blue);
  }
</style>
