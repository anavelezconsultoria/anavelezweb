---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Mensaje enviado" description="Gracias por escribir.">
  <section class="section">
    <div class="container message">
      <p class="eyebrow">Mensaje enviado</p>
      <h1>Gracias por escribir.</h1>
      <p class="lead">Recibí tu mensaje y te respondo pronto.</p>
      <Button href="/" arrow>Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .message {
    display: grid;
    gap: 24px;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }

  h1 {
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.05;
  }
</style>
